# Leave MONGO_URI empty to auto-start an in-memory MongoDB (zero setup, data resets on restart).
# Point it at a real database to persist data, e.g.
# MONGO_URI=mongodb://127.0.0.1:27017/cinebook
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/cinebook
MONGO_URI=

PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Auto-seed demo data when the database is empty (movies, theaters, showtimes, users)
SEED_ON_START=true

# Demo accounts created by the seeder
ADMIN_EMAIL=admin@cinebook.dev
ADMIN_PASSWORD=Admin@123
USER_EMAIL=user@cinebook.dev
USER_PASSWORD=User@123
